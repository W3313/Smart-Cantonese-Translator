// Windows resources for SmartCantoneseTranslator.exe.
// Configured by src/app/CMakeLists.txt (configure_file @ONLY) - do not edit the generated copy.
// The application manifest is embedded separately (packaging/windows/app.manifest is a
// target source, which CMake hands to the MSVC linker), so there is no RT_MANIFEST here.

#pragma code_page(65001)

#include <winver.h>

// Qt uses the resource named IDI_ICON1 as the default window/taskbar icon.
IDI_ICON1 ICON "@SCT_RC_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@SCT_RC_VERSION_TWEAK@
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@SCT_RC_VERSION_TWEAK@
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS       VS_FF_DEBUG
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "@SCT_ORG_NAME@\0"
            VALUE "FileDescription",  "@SCT_APP_NAME@\0"
            VALUE "FileVersion",      "@PROJECT_VERSION@\0"
            VALUE "InternalName",     "@SCT_APP_ID@\0"
            VALUE "LegalCopyright",   "@SCT_RC_COPYRIGHT@\0"
            VALUE "OriginalFilename", "@SCT_RC_EXE_NAME@\0"
            VALUE "ProductName",      "@SCT_APP_NAME@\0"
            VALUE "ProductVersion",   "@PROJECT_VERSION@\0"
            VALUE "Comments",         "@PROJECT_HOMEPAGE_URL@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
